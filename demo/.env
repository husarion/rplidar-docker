# =======================================
# Save your configuration parameters here
# =======================================

# Pick exactly one: serial | tcp | udp
COMPOSE_PROFILES=serial

# --- Serial (A1/A2/A3/C1/S1/S2/S3) ---
# RPLIDAR_SERIAL_DEVICE=/dev/ttyUSB0
# RPLIDAR_BAUDRATE=115200    # A1, A2M8
# RPLIDAR_BAUDRATE=256000    # A2M7/A2M12/A3, S1
# RPLIDAR_BAUDRATE=460800    # C1
# RPLIDAR_BAUDRATE=1000000   # S2, S3

# --- TCP (S1_TCP) ---
# RPLIDAR_TCP_IP=192.168.0.7
# RPLIDAR_TCP_PORT=20108

# --- UDP (T1/S2E) ---
# RPLIDAR_UDP_IP=192.168.11.2
# RPLIDAR_UDP_PORT=8089
